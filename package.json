{
  "name": "@eriksremess/express",
  "type": "module",
  "imports": {
    "#express": "./index.js",
    "#lib/*": "./lib/*.js",
    "#examples/*": "./examples/*.js",
    "#test/*": "./test/*.js"
  },
  "description": "Fast, unopinionated, minimalist web framework",
  "version": "5.2.2",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./bodyParser": "./lib/body-parser/index.js",
    "./cookie": "./lib/cookie.js",
    "./package.json": "./package.json"
  },
  "author": "TJ Holowaychuk <tj@vision-media.ca>",
  "contributors": [
    "Aaron Heckmann <aaron.heckmann+github@gmail.com>",
    "Ciaran Jessup <ciaranj@gmail.com>",
    "Douglas Christopher Wilson <doug@somethingdoug.com>",
    "Guillermo Rauch <rauchg@gmail.com>",
    "Jonathan Ong <me@jongleberry.com>",
    "Roman Shtylman <shtylman+expressjs@gmail.com>",
    "Young Jae Sim <hanul@hanul.me>"
  ],
  "license": "MIT",
  "repository": "github:EriksRemess/express",
  "homepage": "https://github.com/EriksRemess/express",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/express"
  },
  "keywords": [
    "express",
    "framework",
    "sinatra",
    "web",
    "http",
    "rest",
    "restful",
    "router",
    "app",
    "api"
  ],
  "dependencies": {
    "mime-types": "^3.0.2",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "connect-redis": "^9.0.0",
    "cookie-session": "^2.1.1",
    "ejs": "^5.0.2",
    "eslint": "^10.7.0",
    "express-session": "^1.19.0",
    "hbs": "^4.2.1",
    "marked": "^18.0.7",
    "morgan": "^1.11.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">= 26"
  },
  "files": [
    "LICENSE",
    "Readme.md",
    "index.js",
    "lib/"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import ./test/support/env.js --test --test-concurrency=1 ./test/*.js ./test/acceptance/*.js",
    "test-ci": "node --experimental-test-coverage --test-coverage-exclude=examples/** --test-coverage-exclude=test/** --test-coverage-exclude=benchmarks/** --import ./test/support/env.js --test --test-concurrency=1 ./test/*.js ./test/acceptance/*.js",
    "test-cov": "node --experimental-test-coverage --test-coverage-exclude=examples/** --test-coverage-exclude=test/** --test-coverage-exclude=benchmarks/** --import ./test/support/env.js --test --test-concurrency=1 ./test/*.js ./test/acceptance/*.js",
    "test-tap": "node --import ./test/support/env.js --test --test-reporter=tap --test-concurrency=1 ./test/*.js ./test/acceptance/*.js"
  }
}
